DATABASE_URL="postgresql://postgres:postgres@localhost:5433/task_management?schema=public"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-system-email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="LearnNest" <your-system-email@gmail.com>

# Lưu trữ file upload (ảnh đại diện, file đính kèm bình luận)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
# Chỉ dùng khi dev: ghi mã OTP ra log (KHÔNG bật ở production)
OTP_DEBUG_LOG=false

# Đăng nhập mồi cho admin@gmail.com khi DB chưa có tài khoản này (server mới deploy,
# chưa seed). Đăng nhập bằng admin@gmail.com + mật khẩu dưới đây sẽ tự tạo role ADMIN
# + user admin thật rồi cấp token. Sau khi admin đã đăng nhập và đổi mật khẩu, giá trị
# này không còn tác dụng (login đi theo password_hash trong DB). Bỏ trống để dùng mặc định.
BOOTSTRAP_ADMIN_PASSWORD=12341234

