# Production Environment Variables
# Copy this file to .env and fill in the values

# Database (PostgreSQL - set via Render dashboard or here)
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Configuration
JWT_ACCESS_SECRET=generate_a_secure_64_char_hex_string_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_another_secure_64_char_hex_string_here
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Email - use Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="LearnNest <your-email@gmail.com>"

# Cloudinary (File uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OTP Configuration
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
OTP_DEBUG_LOG=false
